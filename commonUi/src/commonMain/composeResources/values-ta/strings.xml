    <string name="feedback_language">மொழி</string>
    <string name="feedback_info_note">பெயர், மின்னஞ்சல், கணக்கு எதுவும் இல்லை — இந்த ID-களும் இந்த ஆப்ஸின் பதிவுகளும் மட்டுமே.</string>
    <string name="feedback_github_title">GitHub-இல் சிக்கலைத் திற</string>
    <string name="feedback_github_hint">பொதுவானது. பிழைகள் மற்றும் யோசனைகளுக்குச் சிறந்தது — மற்றவர்கள் பின்தொடர்ந்து சேர்க்கலாம்.</string>
    <string name="feedback_email_title">%1$s-க்கு மின்னஞ்சல் அனுப்பு</string>
    <string name="feedback_email_hint">தனிப்பட்டது. கணக்கு அல்லது தனிப்பட்ட கேள்விகளுக்குச் சிறந்தது.</string>
    <string name="feedback_email_subject">YMusic கருத்து</string>
    <string name="feedback_prefilled_note">இரண்டும் தகவல் ஏற்கெனவே நிரப்பப்பட்ட நிலையில் திறக்கும். அது இல்லையெனில் ஒட்டவும் — அது இல்லாமல் எங்களால் உதவ முடியாது.</string>
    <string name="feedback_reports_off_title">அநாமதேய அறிக்கைகள் முடக்கப்பட்டுள்ளன</string>
    <string name="feedback_reports_off_message">உங்கள் சிக்கலை ஆராய இந்த ஆப்ஸின் பதிவுகள் தேவை. தொடர் என்பதைத் தட்டினால், YMusic அநாமதேய அறிக்கைகளை மீண்டும் இயக்கிப் பதிவுகளை அனுப்பும்.</string>
    <string name="feedback_reports_off_note">பெயர், மின்னஞ்சல், கணக்கு எதுவும் அனுப்பப்படாது. அமைப்புகளில் அறிக்கைகளை மீண்டும் முடக்கலாம்.</string>
    <string name="feedback_continue">தொடர்</string>
    <string name="feedback_sentry_link">அல்லது Sentry வழியாக</string>
    <string name="feedback_sentry_title">Sentry வழியாக அனுப்பு</string>
    <string name="feedback_sentry_label">என்ன நடந்தது?</string>
    <string name="feedback_sentry_note">உங்கள் அநாமதேயத் தகவல் இணைக்கப்பட்டுள்ளது. இங்கிருந்து அனுப்பப்படும் செய்திகளுக்கு எங்களால் பதிலளிக்க முடியாது, பதில் வேண்டுமெனில் GitHub அல்லது மின்னஞ்சலைப் பயன்படுத்தவும்.</string>
