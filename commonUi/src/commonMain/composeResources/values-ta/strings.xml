    <!-- Feedback -->
    <string name="feedback_intro">என்ன தவறு நடந்தது அல்லது நீங்கள் எதைப் பார்க்க விரும்புகிறீர்கள் என்பதை GitHub-இல் அல்லது மின்னஞ்சலில் சொல்லுங்கள். உங்கள் பதிவுகளைக் கண்டறிந்து பதிலளிக்க, கீழே உள்ள உங்கள் அநாமதேயத் தகவலைச் சேர்க்கவும்.</string>
