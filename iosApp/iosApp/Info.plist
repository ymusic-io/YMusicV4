<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key><string>YMusic</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>4.0.13</string>
    <key>CFBundleVersion</key><string>17</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <!-- ymusic:// links open the app at the matching page (iOSApp.swift onOpenURL). -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
            <key>CFBundleURLSchemes</key><array><string>ymusic</string></array>
        </dict>
    </array>
    <!-- Plain http to the local network only: a dev build talks to the YMusic server on the build
         machine (-PuseLocalServerIp). Everything else stays https-only. -->
    <key>NSLocalNetworkUsageDescription</key><string>YMusic connects to a development server on your local network.</string>
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsLocalNetworking</key><true/>
    </dict>
    <!-- Compose MP hard-requires this (120Hz ProMotion pacing); its plist sanity check aborts without it. -->
    <key>CADisableMinimumFrameDurationOnPhone</key><true/>
    <key>UILaunchScreen</key><dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UIBackgroundModes</key>
    <array><string>audio</string></array>
    <key>NSCameraUsageDescription</key>
    <string>YMusic uses the camera to scan a QR code shown on your computer so you can sign in on desktop.</string>
    <key>NSFaceIDUsageDescription</key>
    <string>YMusic asks you to unlock the phone before sending your YouTube sign-in to a computer.</string>
</dict>
</plist>
