-- The download queue. One row per task; the service is the single writer, the UI observes selectAll.
-- format/state are enum names (TEXT) so a schema bump isn't needed to add a variant.
CREATE TABLE downloadTask (
    id                TEXT    NOT NULL PRIMARY KEY,
    video_id          TEXT    NOT NULL,
    title             TEXT    NOT NULL,
    artist            TEXT,
    thumbnail_url     TEXT,
    format            TEXT    NOT NULL,
    requested_height  INTEGER,
    state             TEXT    NOT NULL,
    downloaded_bytes  INTEGER NOT NULL DEFAULT 0,
    total_bytes       INTEGER NOT NULL DEFAULT 0,
    file_path         TEXT,
    error_message     TEXT,
    created_at        INTEGER NOT NULL,
    updated_at        INTEGER NOT NULL,
    file_name         TEXT,
    audio_track_id    TEXT,
    -- NULL = no per-task choice (settings preference); '' = explicitly none; else comma-joined codes.
    caption_langs     TEXT,
    audio_language    TEXT,
    caption_language  TEXT,
    -- The failure's CodedError code (category or E#####); error_message holds only a server-minted userMessage.
    error_code        TEXT,
    -- Superseded by audio_quality; unread, kept because older SQLite can't drop a column.
    mp3_source_bitrate INTEGER NOT NULL DEFAULT 0,
    -- AudioQuality enum name.
    audio_quality     TEXT    NOT NULL DEFAULT 'BEST',
    -- The streams the audio and video scratches hold; NULL until a run picks them.
    audio_itag        INTEGER,
    audio_lmt         INTEGER,
    video_itag        INTEGER,
    video_lmt         INTEGER
);

CREATE INDEX downloadTask_created ON downloadTask(created_at);

upsert:
INSERT OR REPLACE INTO downloadTask(
    id, video_id, title, artist, thumbnail_url, format, requested_height,
    state, downloaded_bytes, total_bytes, file_path, error_message, created_at, updated_at,
    file_name, audio_track_id, caption_langs, audio_language, caption_language, error_code, audio_quality,
    audio_itag, audio_lmt, video_itag, video_lmt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateState:
UPDATE downloadTask SET state = ?, error_message = ?, error_code = ?, updated_at = ? WHERE id = ?;

updateStreams:
UPDATE downloadTask SET format = ?, audio_itag = ?, audio_lmt = ?, video_itag = ?, video_lmt = ?, updated_at = ? WHERE id = ?;

updateProgress:
UPDATE downloadTask SET downloaded_bytes = ?, total_bytes = ?, updated_at = ? WHERE id = ?;

updateCompleted:
UPDATE downloadTask SET state = ?, file_path = ?, downloaded_bytes = ?, total_bytes = ?, error_message = NULL, error_code = NULL, updated_at = ? WHERE id = ?;

-- Startup recovery: hold everything that was running or waiting (states passed in) as :paused.
pauseActiveAndQueued:
UPDATE downloadTask SET state = :paused, updated_at = :updatedAt WHERE state IN :states;

deleteById:
DELETE FROM downloadTask WHERE id = ?;

selectAll:
SELECT * FROM downloadTask ORDER BY created_at ASC;

selectById:
SELECT * FROM downloadTask WHERE id = ?;

selectNextQueued:
SELECT * FROM downloadTask WHERE state = ? ORDER BY created_at ASC LIMIT 1;
