package = openssl
headers = openssl/ssl.h openssl/x509_vfy.h openssl/pem.h openssl/bio.h
headerFilter = openssl/*

# Binds the slice of libcurl's TLS backend that CURLOPT_SSL_CTX_FUNCTION needs to add custom CAs to
# the default trust store. Must be the OpenSSL libcurl links, or the SSL_CTX ABI won't match.
# Paths come from the build host, located per target when the build copies this def
# (HostNativeLibrary in buildSrc; search order in kmpHttp/ARCHITECTURE.md).
