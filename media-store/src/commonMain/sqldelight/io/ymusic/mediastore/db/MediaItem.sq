-- A media item is a single audio/video file with its extracted metadata.
-- Identified externally by its uri (UNIQUE); id is a generated surrogate key.
-- fileSize + lastModified are the cheap change/move fingerprint (see findDeletedByFingerprint).
CREATE TABLE mediaItem (
    id                   INTEGER PRIMARY KEY AUTOINCREMENT,
    -- Nullable: a NULL bucketId is an orphan item (no containing bucket yet). A single-file scan
    -- inserts an orphan; a later folder scan adopts it (sets bucketId).
    bucketId             INTEGER REFERENCES bucket(id) ON DELETE CASCADE,
    uri                  TEXT    NOT NULL UNIQUE,
    title                TEXT    NOT NULL,
    mimeType             TEXT    NOT NULL,
    artist               TEXT,
    album                TEXT,
    genre                TEXT,
    trackNumber          INTEGER,
    year                 INTEGER,
    durationMs           INTEGER,
    audioCodec           TEXT,
    videoCodec           TEXT,
    subtitleCodec        TEXT,
    bitrate              INTEGER,
    width                INTEGER,
    height               INTEGER,
    thumbnailStreamIndex INTEGER,
    youtubeVid           TEXT,
    youtubeItags         TEXT,
    fileSize             INTEGER NOT NULL,
    lastModified         INTEGER NOT NULL,
    deleted              INTEGER NOT NULL DEFAULT 0,
    createdAt            INTEGER NOT NULL,
    updatedAt            INTEGER NOT NULL,
    -- dB from the file's measured loudness to its target; NULL when unmeasured.
    loudnessGainDb       REAL
);

CREATE INDEX mediaItem_bucketId     ON mediaItem(bucketId);
CREATE INDEX mediaItem_fileSize     ON mediaItem(fileSize);
CREATE INDEX mediaItem_updatedAt    ON mediaItem(updatedAt);
-- findItemByVideoId is per-playlist-entry (playlistItemDetails resolves each membership code) and
-- via public findItemsByVideoId; without this index every lookup is a full table scan, making
-- playlistItemDetails O(playlist x table).
CREATE INDEX mediaItem_youtubeVid ON mediaItem(youtubeVid);

insertItem:
INSERT INTO mediaItem(
    bucketId, uri, title, mimeType, artist, album, genre, trackNumber, year, durationMs,
    audioCodec, videoCodec, subtitleCodec, bitrate, width, height, thumbnailStreamIndex,
    youtubeVid, youtubeItags, fileSize, lastModified, deleted, createdAt, updatedAt, loudnessGainDb
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?, ?);

lastInsertRowId:
SELECT last_insert_rowid();

-- Full metadata update by id, also un-deletes. Used for the plain "changed in place" path AND
-- the move-in-place path (the row id is preserved, so playlist FKs survive).
-- bucketId uses COALESCE(?, bucketId): a non-null value adopts the item into that bucket (a folder
-- scan claiming an orphan), while NULL preserves the current bucket — so a single-file scan can never
-- un-adopt (re-orphan) an already-filed item.
updateItem:
UPDATE mediaItem SET
    bucketId = COALESCE(:bucketId, bucketId), uri = ?, title = ?, mimeType = ?, artist = ?, album = ?, genre = ?, trackNumber = ?,
    year = ?, durationMs = ?, audioCodec = ?, videoCodec = ?, subtitleCodec = ?, bitrate = ?,
    width = ?, height = ?, thumbnailStreamIndex = ?, youtubeVid = ?, youtubeItags = ?,
    fileSize = ?, lastModified = ?, deleted = 0, updatedAt = ?, loudnessGainDb = ?
WHERE id = ?;

-- The file was renamed/moved by the app: same row (playlist links, metadata), new location.
updateItemUri:
UPDATE mediaItem SET uri = ?, updatedAt = ? WHERE id = ?;

setItemDeleted:
UPDATE mediaItem SET deleted = 1, updatedAt = ? WHERE id = ?;

setItemsInBucketDeleted:
UPDATE mediaItem SET deleted = 1, updatedAt = ? WHERE bucketId = ? AND deleted = 0;

-- Detach every item from a bucket and tombstone it (regardless of current state), so the bucket can
-- be hard-deleted without the FK cascade taking the items with it. Used when excluding a folder: the
-- subfolder rows are removed but their items are kept as tombstones (playlist links, later revival).
orphanAndDeleteItemsInBucket:
UPDATE mediaItem SET bucketId = NULL, deleted = 1, updatedAt = ? WHERE bucketId = ?;

-- Hard-purge tombstones older than a cutoff (cascades to playlistItem rows). Returns rows removed.
purgeDeleted:
DELETE FROM mediaItem WHERE deleted = 1 AND updatedAt < ?;

-- Hard-delete a single item now (cascades to its playlistItem rows).
hardDeleteItem:
DELETE FROM mediaItem WHERE id = ?;

findItemById:
SELECT * FROM mediaItem WHERE id = ? AND deleted = 0;

findItemByUri:
SELECT * FROM mediaItem WHERE uri = ? AND deleted = 0;

findItemByUriIncludingDeleted:
SELECT * FROM mediaItem WHERE uri = ?;

-- Resolve a "@fileSize:durationSec" playlist code back to an item — duration compared in whole
-- seconds (matches the code's (durationMs ?: 0) / 1000, absorbing sub-second wobble). May match
-- more than one item on a collision; callers take the first.
findItemByFingerprint:
SELECT * FROM mediaItem
WHERE fileSize = ? AND COALESCE(durationMs, 0) / 1000 = ? AND deleted = 0;

itemsInBucket:
SELECT * FROM mediaItem WHERE bucketId = ? AND deleted = 0 ORDER BY title;

-- Every non-deleted item regardless of bucket, one library-wide list. Items in an excluded folder
-- are soft-deleted (see setBucketExcluded), so the deleted filter already hides them.
allItems:
SELECT * FROM mediaItem WHERE deleted = 0 ORDER BY title COLLATE NOCASE;

-- Orphan items (no bucket yet) — not under any folder.
orphanItems:
SELECT * FROM mediaItem WHERE bucketId IS NULL AND deleted = 0 ORDER BY title;

itemsByIds:
SELECT * FROM mediaItem WHERE id IN ? AND deleted = 0;

findItemByVideoId:
SELECT * FROM mediaItem WHERE youtubeVid = ? AND deleted = 0;

-- Every YouTube video the Library holds a file of — what feeds mark "available offline".
youtubeVideoIds:
SELECT DISTINCT youtubeVid FROM mediaItem WHERE youtubeVid IS NOT NULL AND deleted = 0;
